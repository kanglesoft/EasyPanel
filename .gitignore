# =========================================================================
# Secrets — NEVER commit
# =========================================================================
# 注意：.gitignore 不支持行内注释，`#` 必须独占一行。
.env
.env.*
# 保留已提交的模板文件（上面的 .env.* 会匹配到它，必须显式否定）
!.env.example
*.local.env

# kangle/easypanel 节点配置本体（含真实凭据）。
# 只提交模板 node.cfg.php.example；运行期文件由 install.sh 从模板生成并 chmod 600。
# SEC-13 要求 `git ls-files | grep node.cfg.php` 无命中。
data/kangle/etc/node.cfg.php
!data/kangle/etc/node.cfg.php.example

# =========================================================================
# Docker 本地覆盖配置（个人开发用，不入库）
# =========================================================================
docker-compose.override.yml
docker-compose.*.override.yml

# =========================================================================
# IDE / editor — local-only cruft (may contain credentials, never commit)
# =========================================================================
.trae/
.idea/
.vscode/
.cursor/
.windsurf/
.claude/
.workbuddy/
*.swp
*~
.project
.settings/

# =========================================================================
# OS metadata
# =========================================================================
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================================================================
# Node / JS (if any frontend tooling is added later)
# =========================================================================
node_modules/
dist/
build/
coverage/
.npm/
.yarn/

# =========================================================================
# Python (venvs / caches, e.g. isolated Playwright venv)
# =========================================================================
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =========================================================================
# Logs / runtime artifacts (broad, plus kangle-specific globs below)
# =========================================================================
*.log
logs/
*.pid
*.sock
*.orig
*.rej
*.bak

# =========================================================================
# kangle runtime dirs — regenerated by the entrypoint on the bind mount
# (session/tmp data must NOT be committed; regenerated on container start)
# =========================================================================
data/kangle/tmp/
data/kangle/var/
data/kangle/run/
data/kangle/nodewww/tmp/
data/kangle/sessions/

# kangle runtime template/session caches are ignored above; HOWEVER the glob
# `data/kangle/**/cache/` must NOT swallow phpMyAdmin's Composer vendor. Several
# vendor packages legitimately ship a directory literally named "cache" that is
# real, load-bearing source code:
#   vendor/phpmyadmin/motranslator/src/Cache  (InMemoryCache -> fatal "Class not found")
#   vendor/psr/cache                         (PSR-6 Cache interfaces)
#   vendor/symfony/cache                     (Symfony Cache component)
#   vendor/twig/twig/src/Cache               (Twig compiled-template cache dir)
# If these are dropped, phpMyAdmin returns HTTP 500 on the login page
# ("Uncaught Error: Class 'PhpMyAdmin\MoTranslator\Cache\InMemoryCache' not found").
# Re-include them (explicit per-directory, since git's `**` negation is unreliable
# for re-including ignored directories) so a fresh `git clone` always ships a
# working phpMyAdmin. See fix(phpmyadmin): keep vendor cache packages tracked.
data/kangle/**/cache/
!data/kangle/nodewww/dbadmin/mysql/vendor/phpmyadmin/motranslator/src/Cache/
!data/kangle/nodewww/dbadmin/mysql/vendor/psr/cache/
!data/kangle/nodewww/dbadmin/mysql/vendor/symfony/cache/
!data/kangle/nodewww/dbadmin/mysql/vendor/twig/twig/src/Cache/
data/kangle/**/*.log
data/kangle/**/*.sock
data/kangle/**/*.pid

# =========================================================================
# kangle 运行期安装锁 / 标记文件（entrypoint 启动时重新生成）
# =========================================================================
install.lock
data/kangle/**/install.lock

# =========================================================================
# MySQL datadir (regenerated by mysql container at runtime)
# =========================================================================
data/mysql/

# =========================================================================
# kangle runtime sqlite databases (regenerated on init / at runtime)
# =========================================================================
data/kangle/**/*.db

# =========================================================================
# Smarty compiled templates (regenerated at runtime)
# =========================================================================
data/kangle/nodewww/webftp/framework/templates_c/
