<!--#start 62-->
<config>
  <!-- 系统面板虚拟主机：admin/vhost 后台与 phpMyAdmin -->
  <vhs>
    <vh name='_webftp' doc_root='/vhs/kangle/nodewww/webftp' index='index.html,index.php' app_share='0' inherit='off'>
      <map file_ext='php' extend='cmd:php74' allow_method='*'/>
      <port>3312</port>
      <host>*</host>
    </vh>
    <vh name='_dbadmin' doc_root='/vhs/kangle/nodewww/dbadmin' index='index.html,index.php' app_share='0' inherit='off'>
      <map file_ext='php' extend='cmd:php74' allow_method='*'/>
      <port>3313</port>
      <host>*</host>
    </vh>
  </vhs>
</config>
